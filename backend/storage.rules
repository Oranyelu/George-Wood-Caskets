
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Product images: Public read, admin write
    match /products/{productId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth.token.admin == true;
    }

    // Invoice PDFs: Private, only accessible via signed URLs
    match /invoices/{invoiceId}.pdf {
      allow read, write: if request.auth.token.admin == true;
    }

    // User profile pictures: Users can only write to their own path
    match /users/{userId}/{allPaths=**} {
      allow write: if request.auth.uid == userId;
    }

    // Tribute images: Authenticated users can write
    match /tributes/{tributeId}/{allPaths=**} {
      allow write: if request.auth != null;
    }
  }
}
