rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is admin
    // Requires a 'users' collection where document ID is the user's UID and has field 'role': 'admin'
    function isAdmin() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Default: Deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Users: Users can read/write their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if isAdmin();
    }

    // Products: Public read, Admin write
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders: Public create (for guest checkout) but require basic data, User read own, Admin read/update
    match /orders/{orderId} {
      allow create: if request.resource.data.keys().hasAll(['items', 'totalPrice', 'createdAt']) &&
                       (request.resource.data.totalPrice is number) &&
                       (request.resource.data.totalPrice > 0);
      allow read: if (request.auth != null && request.auth.uid == resource.data.userId) || isAdmin();
      allow update: if isAdmin();
    }

    // Messages: Public create, Admin read
    match /messages/{messageId} {
      allow create: if true;
      allow read: if isAdmin();
    }

    // Inquiries: Public create, Admin read/write
    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read, write: if isAdmin();
    }

    // Volunteers: Public create, Admin read/write
    match /volunteers/{volunteerId} {
      allow create: if true;
      allow read, write: if isAdmin();
    }

    // Reports: Public create, Admin read/write
    match /reports/{reportId} {
      allow create: if true;
      allow read, write: if isAdmin();
    }

    // Donations: Public create, Admin read/write
    match /donations/{donationId} {
      allow create: if true;
      allow read, write: if isAdmin();
    }

    // Bonds & Payments: Public create, Admin read/write
    match /bonds/{bondId} {
      allow create: if true;
      allow read, write: if isAdmin();
    }
    match /payments/{paymentId} {
      allow create: if true;
      allow read, write: if isAdmin();
    }

    // Charity Projects: Public read, Admin write
    match /charityProjects/{projectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Blog Posts & Memorials: Public read, Admin write
    match /memorials/{memorialId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /posts/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
