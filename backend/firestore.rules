
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Products: Public read, admin write
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth.token.admin == true;
    }

    // Orders: Authenticated users can create, only owners or admins can read
    match /orders/{orderId} {
      allow create: if request.auth != null;
      allow read: if request.auth.uid == resource.data.customerId || request.auth.token.admin == true;
      allow update: if request.auth.token.admin == true;
    }

    // Invoices: Only owners or admins can read
    match /invoices/{invoiceId} {
      allow read: if get(/databases/$(database)/documents/orders/$(resource.data.orderId)).data.customerId == request.auth.uid || request.auth.token.admin == true;
      allow write: if request.auth.token.admin == true;
    }

    // Users: Users can only access their own data
    match /users/{userId} {
      allow read, write: if request.auth.uid == userId;
    }

    // Activity Logs: Users can only write to their own activity logs
    match /users/{userId}/activityLogs/{logId} {
      allow create: if request.auth.uid == userId;
    }

    // Audits: Admin only
    match /audits/{auditId} {
      allow read, write: if request.auth.token.admin == true;
    }

    // Bonds: Public read, admin write
    match /bonds/{bondId} {
      allow read: if true;
      allow write: if request.auth.token.admin == true;
    }

    // Investments: Owners and admins can read, only authenticated users can create
    match /investments/{investmentId} {
      allow create: if request.auth != null;
      allow read: if request.auth.uid == resource.data.investorId || request.auth.token.admin == true;
    }

    // Custom Orders: Authenticated users can create, owners and admins can read
    match /customOrders/{requestId} {
      allow create: if request.auth != null;
      allow read: if request.auth.uid == resource.data.customerInfo.uid || request.auth.token.admin == true;
      allow update: if request.auth.token.admin == true;
    }

    // Tributes: Public read, authenticated users can create
    match /tributes/{tributeId} {
      allow read: if true;
      allow create: if request.auth != null;
    }

    // Impressions: Allow all writes (for now)
    match /impressions/{impressionId} {
      allow write: if true;
    }

    // Recommendations: Public read, admin write
    match /recommendations/{recommendationId} {
      allow read: if true;
      allow write: if request.auth.token.admin == true;
    }
  }
}
